# Database Configuration
# Format: postgresql://username:password@host:port/database
# Example for local PostgreSQL:
DATABASE_URL=postgresql://postgres:password@localhost:5432/menb

# Optional - Database schema (defaults to 'menb')
SCHEMA=menb

# Optional - Server port (defaults to 3000)
PORT=3000

# Optional - JWT secret key (only needed in production)
# TOKEN_SIGN_KEY=your-secret-key-here

# Optional - Set to 'true' to disable image loading
# NO_IMAGE=false
